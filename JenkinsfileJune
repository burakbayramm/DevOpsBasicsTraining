pipeline {
    agent any
    options {
        buildDiscarder logRotator(artifactDaysToKeepStr: '', artifactNumToKeepStr: '2', daysToKeepStr: '', numToKeepStr: '3')
    }
    parameters {
        string defaultValue: 'june26/feature1', description: 'Source Code Branch', name: 'checkout_branch'
        }

    stages {
        stage('SourceCode Checkout') {
            steps {
                cleanWs()
                checkout scmGit(branches: [[name: params.checkout_branch]], extensions: [], userRemoteConfigs: [[url: 'https://github.com/burakbayramm/DevOpsBasicsTraining']])
                sh """
                echo "Source Code Downloading!"
                sleep 6
                """
            }
      }
    
        stage('Build with Maven') {
            tools {
                maven 'maven3.2.5'
            }
            steps {
            sh """
            mvn clean install
            cp target/demo-0.0.1-SNAPSHOT.jar DevOpsBasics-${BUILD_NUMBER}.jar
            """
            
            }
        }
  
        stage('Build') {
            tools {
                gradle 'gradle9.6'
            }
            steps {
            sh """
            echo "Project is building"
            gradle --version
            sleep 6
            touch devopsBasics.jar
            """
            
            }
        }
        stage ('Archive Artifacts'){
            steps{
                archiveArtifacts artifacts: '*.jar', followSymlinks: false
            }
        }

        }

}