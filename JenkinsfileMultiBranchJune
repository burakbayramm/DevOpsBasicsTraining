pipeline {
    agent any
    options {
        buildDiscarder logRotator(artifactDaysToKeepStr: '', artifactNumToKeepStr: '2', daysToKeepStr: '', numToKeepStr: '3')
    }
    stages {
        stage('SourceCode Checkout') {
            steps {
                cleanWs()
                checkout scm
                sh """
                ls -ltr
                """
            }
      }
    
        stage('Build with Maven') {
            tools {
                maven 'maven3.2.5'
            }
            steps {
            sh """
            mvn clean install
            cp target/demo-0.0.1-SNAPSHOT.jar DevOpsBasics-${BUILD_NUMBER}.jar
            """
            
            }
        }
        stage ('Archive Artifacts'){
            steps{
                archiveArtifacts artifacts: '*.jar', followSymlinks: false
            }
        }
         stage ('Stage Difference'){
            steps{
                sh " echo 'This is the difference between june26/feature1 and june26/feature2'"
            }
        }

        }

}